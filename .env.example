# Django settings
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
# Для локального запуска Django используйте 127.0.0.1 или localhost
# PostgreSQL должен быть установлен и запущен локально
PG_NAME=your_database_name
PG_USER=your_database_user
PG_PASSWORD=your_database_password
PG_HOST=127.0.0.1
PG_PORT=5432

# Email settings
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here

# Site URL
SITE_URL=http://localhost:8000

# Redis (для Celery)
# Для локального Django: redis://127.0.0.1:6379/0
# Redis запускается в Docker через docker-compose up
REDIS_URL=redis://127.0.0.1:6379/0

# Celery Flower monitoring (опционально)
# После запуска docker-compose: http://localhost:5555
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:password_here
